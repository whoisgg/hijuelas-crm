# ============================================================================
# Hijuelas CRM — variables de entorno
# ============================================================================
# Copia este archivo a `.env.local` y rellena los valores reales.
# Nunca commitees `.env.local` (está en `.gitignore`).

# ---- Supabase ---------------------------------------------------------------
# Dashboard: https://supabase.com/dashboard/project/hvlwkmyftnrasebecaet/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://hvlwkmyftnrasebecaet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo backend / server actions / scripts. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Postgres / Drizzle -----------------------------------------------------
# Connection pooler (transaction mode) — para la app Next.js.
# Dashboard: Project Settings → Database → Connection string → "Transaction"
DATABASE_URL=postgresql://postgres.hvlwkmyftnrasebecaet:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Direct connection — solo para migrations con drizzle-kit
# Dashboard: Project Settings → Database → Connection string → "URI"
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.hvlwkmyftnrasebecaet.supabase.co:5432/postgres
